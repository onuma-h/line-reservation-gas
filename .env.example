# =============================================================
# LINE予約システム 設定サンプル (.env.example)
# -------------------------------------------------------------
# 注意: Google Apps Script は実行時に .env を読み込みません。
# 下の値は「GASのプロジェクトの設定 → スクリプト プロパティ」に
# 登録してください。このファイルは必要な設定項目の一覧・控えです。
# =============================================================

# LINE Messaging API のチャネルアクセストークン(長期) ※必須
CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN

# 予約データを保存する Google スプレッドシートの ID ※必須
SPREADSHEET_ID=YOUR_SPREADSHEET_ID

# 予約一覧シート名(未設定なら「予約一覧」) ※任意
SHEET_NAME=予約一覧

# 管理者の通知先メールアドレス(新規予約・キャンセル通知) ※任意
ADMIN_EMAIL=you@example.com

# 管理者の LINE ユーザーID(LINE通知を使う場合のみ。既定はメール通知のみ) ※任意
ADMIN_USER_ID=YOUR_LINE_USER_ID
